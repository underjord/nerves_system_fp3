diff -Nur a/drivers/misc/dtbo_loader.c b/drivers/misc/dtbo_loader.c
--- a/drivers/misc/dtbo_loader.c	1970-01-01 01:00:00
+++ b/drivers/misc/dtbo_loader.c	2026-10-20 12:08:30
@@ -0,0 +1,191 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * /dev/dtbo: apply and remove device tree overlays from userspace.
+ *
+ * write() a compiled overlay (a flattened device tree, so it starts with
+ * the 0xd00dfeed magic) and it is applied with of_overlay_fdt_apply(). The
+ * changeset ID is logged, and read() lists the applied overlays as
+ * "<id> <bytes>" lines. write() the text "remove <id>" to revert one.
+ *
+ * The kernel keeps its own copy of the overlay. Nodes appear in and leave
+ * the live tree, so drivers probe and unbind accordingly: this is how a
+ * node is tried on a board that boots a static DTB, without a reflash per
+ * attempt. Root only.
+ */
+
+#include <linux/fs.h>
+#include <linux/kernel.h>
+#include <linux/list.h>
+#include <linux/miscdevice.h>
+#include <linux/module.h>
+#include <linux/mutex.h>
+#include <linux/of.h>
+#include <linux/of_fdt.h>
+#include <linux/sizes.h>
+#include <linux/slab.h>
+#include <linux/string.h>
+#include <linux/uaccess.h>
+
+#define DTBO_MAX_SIZE	SZ_1M
+
+struct dtbo_overlay {
+	struct list_head list;
+	int ovcs_id;
+	size_t size;
+};
+
+static LIST_HEAD(dtbo_overlays);
+static DEFINE_MUTEX(dtbo_lock);
+
+static int dtbo_apply(const void *fdt, size_t size)
+{
+	struct dtbo_overlay *ov;
+	int ret;
+
+	ov = kzalloc(sizeof(*ov), GFP_KERNEL);
+	if (!ov)
+		return -ENOMEM;
+
+	ret = of_overlay_fdt_apply(fdt, size, &ov->ovcs_id, NULL);
+	if (ret) {
+		pr_err("dtbo: applying a %zu byte overlay failed: %d\n",
+		       size, ret);
+		kfree(ov);
+		return ret;
+	}
+	ov->size = size;
+
+	mutex_lock(&dtbo_lock);
+	list_add_tail(&ov->list, &dtbo_overlays);
+	mutex_unlock(&dtbo_lock);
+
+	pr_info("dtbo: applied overlay %d (%zu bytes)\n", ov->ovcs_id, size);
+
+	return 0;
+}
+
+static int dtbo_remove(int id)
+{
+	struct dtbo_overlay *ov, *found = NULL;
+	int ret;
+
+	mutex_lock(&dtbo_lock);
+	list_for_each_entry(ov, &dtbo_overlays, list) {
+		if (ov->ovcs_id == id) {
+			found = ov;
+			list_del(&found->list);
+			break;
+		}
+	}
+	mutex_unlock(&dtbo_lock);
+
+	if (!found)
+		return -ENOENT;
+
+	ret = of_overlay_remove(&found->ovcs_id);
+	if (ret) {
+		pr_err("dtbo: removing overlay %d failed: %d\n", id, ret);
+		mutex_lock(&dtbo_lock);
+		list_add_tail(&found->list, &dtbo_overlays);
+		mutex_unlock(&dtbo_lock);
+		return ret;
+	}
+
+	kfree(found);
+	pr_info("dtbo: removed overlay %d\n", id);
+
+	return 0;
+}
+
+static ssize_t dtbo_write(struct file *filp, const char __user *ubuf,
+			  size_t count, loff_t *ppos)
+{
+	char cmd[32];
+	size_t cmd_len;
+	void *buf;
+	int id, ret;
+
+	if (count < 4 || count > DTBO_MAX_SIZE)
+		return -EINVAL;
+
+	buf = kvmalloc(count, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+	if (copy_from_user(buf, ubuf, count)) {
+		kvfree(buf);
+		return -EFAULT;
+	}
+
+	if (be32_to_cpup((const __be32 *)buf) == OF_DT_HEADER) {
+		ret = dtbo_apply(buf, count);
+		kvfree(buf);
+		return ret ? ret : count;
+	}
+
+	/* Not a device tree: a text command. */
+	cmd_len = min(count, sizeof(cmd) - 1);
+	memcpy(cmd, buf, cmd_len);
+	cmd[cmd_len] = '\0';
+	kvfree(buf);
+
+	if (sscanf(cmd, "remove %d", &id) == 1) {
+		ret = dtbo_remove(id);
+		return ret ? ret : count;
+	}
+
+	return -EINVAL;
+}
+
+static ssize_t dtbo_read(struct file *filp, char __user *ubuf, size_t count,
+			 loff_t *ppos)
+{
+	struct dtbo_overlay *ov;
+	size_t len = 0;
+	ssize_t ret;
+	char *buf;
+
+	buf = kzalloc(PAGE_SIZE, GFP_KERNEL);
+	if (!buf)
+		return -ENOMEM;
+
+	mutex_lock(&dtbo_lock);
+	list_for_each_entry(ov, &dtbo_overlays, list)
+		len += scnprintf(buf + len, PAGE_SIZE - len, "%d %zu\n",
+				 ov->ovcs_id, ov->size);
+	mutex_unlock(&dtbo_lock);
+
+	ret = simple_read_from_buffer(ubuf, count, ppos, buf, len);
+	kfree(buf);
+
+	return ret;
+}
+
+static const struct file_operations dtbo_fops = {
+	.owner = THIS_MODULE,
+	.read = dtbo_read,
+	.write = dtbo_write,
+	.llseek = default_llseek,
+};
+
+static struct miscdevice dtbo_misc = {
+	.minor = MISC_DYNAMIC_MINOR,
+	.name = "dtbo",
+	.fops = &dtbo_fops,
+	.mode = 0600,
+};
+
+static int __init dtbo_init(void)
+{
+	return misc_register(&dtbo_misc);
+}
+
+static void __exit dtbo_exit(void)
+{
+	misc_deregister(&dtbo_misc);
+}
+
+module_init(dtbo_init);
+module_exit(dtbo_exit);
+
+MODULE_DESCRIPTION("Userspace device tree overlay loader");
+MODULE_LICENSE("GPL");
